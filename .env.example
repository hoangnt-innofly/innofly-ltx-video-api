APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 1 = skip GPU and return a placeholder mp4 (API contract demo)
LTX_MOCK=0

# 12GB default: single-scale distilled (no spatial upscaler).
# Use configs/ltxv-2b-0.9.8-distilled.yaml on 16GB+ if you want multi-scale.
LTX_PIPELINE_CONFIG=configs/ltxv-2b-0.9.8-distilled-lowvram.yaml

LTX_DEFAULT_WIDTH=512
LTX_DEFAULT_HEIGHT=320
LTX_DEFAULT_NUM_FRAMES=49
LTX_DEFAULT_FRAME_RATE=24
LTX_DEFAULT_SEED=42

MAX_UPLOAD_MB=20
JOB_TTL_SECONDS=86400

# Cap PyTorch VRAM (GiB). 11 = leave ~0.6GB on a 12GB card. 10 = tighter. 0 = unlimited.
LTX_MAX_GPU_MEMORY_GB=11

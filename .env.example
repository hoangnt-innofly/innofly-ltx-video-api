APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 1 = placeholder mp4 (no GPU). 0 = real LTX-Video.
LTX_MOCK=0

# 12GB (RTX 3060 / 11.6GiB): single-scale, no spatial upscaler.
# Do not use configs/ltxv-2b-0.9.8-distilled.yaml on 12GB (multi-scale OOM).
LTX_PIPELINE_CONFIG=configs/ltxv-2b-0.9.8-distilled-lowvram.yaml

LTX_DEFAULT_WIDTH=512
LTX_DEFAULT_HEIGHT=320
LTX_DEFAULT_NUM_FRAMES=33
LTX_DEFAULT_FRAME_RATE=24
LTX_DEFAULT_SEED=42

MAX_UPLOAD_MB=20
JOB_TTL_SECONDS=86400

# 0 = do not cap PyTorch below the real GPU size.
# Do NOT set 10 or 11 on an 11.6GiB card — that causes "11.00 GiB allowed" OOM.
LTX_MAX_GPU_MEMORY_GB=0

# 1 = keep T5/VAE in RAM, GPU runs one stage at a time (~7-8GB VRAM, slower).
# Needs ~24GB system RAM. Set 0 only if the GPU is dedicated and has 12GB free.
LTX_CPU_OFFLOAD=1

# Must be in process env before Python/CUDA starts (copy into .env, Docker, or systemd).
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
